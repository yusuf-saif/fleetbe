{
	admin off
	auto_https off
	persist_config off

	servers {
		# Railway terminates TLS and forwards plain HTTP to this container.
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For X-Real-IP
	}
}

:{$PORT:8080} {
	root * /var/www/public

	# php-fpm listens on TCP 9000 inside this container.
	php_fastcgi 127.0.0.1:9000

	encode zstd gzip
	file_server
}
